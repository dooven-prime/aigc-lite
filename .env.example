AIGC_LITE_APP_NAME=aigc-lite
AIGC_LITE_HOST=127.0.0.1
AIGC_LITE_PORT=8000
AIGC_LITE_DEBUG=false
AIGC_LITE_API_KEY=
# Optional JSON array for multiple isolated tenants.
# AIGC_LITE_TENANTS_JSON=[{"id":"team-a","name":"Team A","api_key":"change-me"}]
AIGC_LITE_LLM_API_KEY=
AIGC_LITE_LLM_BASE_URL=https://api.openai.com/v1
AIGC_LITE_LLM_MODEL=gpt-4o-mini
AIGC_LITE_LLM_TIMEOUT=120
AIGC_LITE_DATA_DIR=data
AIGC_LITE_MAX_AGENT_STEPS=8
AIGC_LITE_MAX_TOOL_RESULT_CHARS=100000
AIGC_LITE_MAX_TOOL_RECORD_CHARS=50000
AIGC_LITE_DEFAULT_TOOL_TIMEOUT_SECONDS=30
AIGC_LITE_DATABASE_URL=
AIGC_LITE_AUTH_SECRET=change-this-in-production
# Independent Fernet key for credentials stored at rest. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIGC_LITE_MASTER_KEY=
AIGC_LITE_ALLOW_SIGNUP=true
AIGC_LITE_MCP_API_KEY=
# Only used by the deprecated hand-written /mcp-legacy endpoint.
AIGC_LITE_LEGACY_MCP_PROTOCOL_VERSION=2025-06-18
AIGC_LITE_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
AIGC_LITE_MCP_ALLOWED_ORIGINS=
# Remote MCP tools. Header values reference environment variable names, never secrets.
# AIGC_LITE_MCP_SERVERS_JSON=[{"id":"research","url":"http://127.0.0.1:9000/mcp","workspace_id":"default","header_env":{"Authorization":"RESEARCH_MCP_AUTH"},"risk":"low"}]
AIGC_LITE_SESSION_TTL_HOURS=168
AIGC_LITE_RATE_LIMIT_PER_MINUTE=60
AIGC_LITE_ADMIN_EMAIL=
AIGC_LITE_ADMIN_PASSWORD=
